# Copy to `.env` locally if you use a dotenv loader, or pass via --dart-define (recommended).
# Never commit real secrets.

# Google Maps / Places / Directions (same key as Android/iOS Maps SDK setup)
MAPS_API_KEY=

# Legacy FCM HTTP sender: value for Authorization header, e.g. key=AAAA...
FCM_AUTH_HEADER=

# Places autocomplete language code
PLACES_LANGUAGE=ro
